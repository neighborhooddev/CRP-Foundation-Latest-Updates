// ============================================================
// COMMAND TEXT PARSER
//
// Tanpa plugin command processor.
// Menangkap command dari OnPlayerCommandText.
// ============================================================

public OnPlayerCommandText(playerid, cmdtext[])
{
    if(cmdtext[0] != '/')
        return 0;

    new length = strlen(cmdtext);

    if(length <= 1)
        return 0;

    new position = 1;

    while(cmdtext[position] != ' ' &&
          cmdtext[position] != EOS)
    {
        position++;
    }

    new commandLength = position - 1;

    if(commandLength <= 0)
        return 0;

    if(commandLength >= sizeof(gAdminCommand))
        commandLength = sizeof(gAdminCommand) - 1;

    strmid(
        gAdminCommand,
        cmdtext,
        1,
        position,
        sizeof(gAdminCommand)
    );

    gAdminCommand[commandLength] = EOS;

    gAdminParams[0] = EOS;

    if(cmdtext[position] == ' ')
    {
        while(cmdtext[position] == ' ')
            position++;

        if(cmdtext[position] != EOS)
        {
            strmid(
                gAdminParams,
                cmdtext,
                position,
                length,
                sizeof(gAdminParams)
            );
        }
    }

    return CRP_AdminDispatchCommand(
        playerid,
        gAdminCommand,
        gAdminParams
    );
}



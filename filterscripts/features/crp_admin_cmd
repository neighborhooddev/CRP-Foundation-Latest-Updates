    new target2 = CRP_AdminFindPlayer(second);

    if(!CRP_AdminRequireTarget(playerid, target1))
        return 1;

    if(!CRP_AdminRequireTarget(playerid, target2))
        return 1;

    CallRemoteFunction(
        "CRP_AdminCommandP2P",
        "iii",
        playerid,
        target1,
        target2
    );

    return 1;
}



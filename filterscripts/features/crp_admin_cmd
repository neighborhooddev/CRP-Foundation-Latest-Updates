// SERVER
// ============================================================

stock CRP_AdminCommand_Announce(playerid, const params[])
{
    if(!CRP_AdminRequireDuty(playerid, ADMIN_SENIOR_ADMIN))
        return 1;

    if(!strlen(params))
    {
        SendClientMessage(
            playerid,
            COLOR_YELLOW,
            "USAGE: /announce [message]"
        );

        return 1;
    }

    new username[64];
    CRP_AdminGetAccountUsername(
        playerid,
        username,
        sizeof(username)
    );

    new message[256];

    format(
        message,
        sizeof(message),
        "AdminCmd: %s: %s",
        username,
        params
    );

    SendClientMessageToAll(
        COLOR_GOLD,
        message

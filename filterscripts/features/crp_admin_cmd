    if(!CRP_AdminRequireDuty(playerid, ADMIN_HELPER))
        return 1;

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i))
            continue;

        if(i == playerid)

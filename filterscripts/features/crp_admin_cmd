stock CRP_AdminCommand_A(playerid, const params[])
{
    if(!CRP_AdminRequireStaff(playerid, ADMIN_INTERN))
        return 1;

    if(!strlen(params))
    {
        SendClientMessage(
            playerid,
            COLOR_YELLOW,
            "USAGE: /a [message]"
        );

        return 1;
    }

    new username[64];
    CRP_AdminGetAccountUsername(
        playerid,
        username,
        sizeof(username)
    );

    new message[256];

    format(
        message,
        sizeof(message),
        "{D8B56A}[%s] {FFFFFF}%s",
        username,
        params
    );

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i))
            continue;

        if(!CRP_AdminIsStaff(i))
            continue;

        SendClientMessage(
            i,
            COLOR_WHITE,
            message
        );
    }

    return 1;
}


